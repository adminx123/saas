{
    "name": "my-web-app",
    "version": "1.0.0",
    "description": "A web application project.",
    "type": "module",
    "main": "index.js",
    "scripts": {
        "test": "jest",
        "login": "npx wrangler login",
        "deploy:orchestrator": "node scripts/sync-bindings.mjs && npx wrangler deploy --config workers/orchestrator/wrangler-orchestrator.toml",
        "sync-bindings": "node scripts/sync-bindings.mjs",
        "prewarm": "node scripts/prewarm-translations.mjs",
        "deploy:widget": "npx wrangler pages deploy widget --project-name=master-widget",
        "deploy:inexasli": "npx wrangler deploy --config client/inexasli/config-inexasli.toml",
        "deploy:payment": "npx wrangler deploy --config workers/payment/stripe-saas.toml",
        "flows:pull": "node scripts/flows-pull.mjs",
        "flows:push": "node scripts/flows-push.mjs",
        "flows:push:one": "node scripts/flows-push.mjs",
        "prompts:pull": "node scripts/prompts-pull.mjs",
        "prompts:push": "node scripts/prompts-push.mjs",
        "pull": "npm run flows:pull && npm run prompts:pull",
        "push": "npm run flows:push && npm run prompts:push"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "wrangler": "^4.107.0"
    }
}
